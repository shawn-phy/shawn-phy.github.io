---
// Authored stand-ins for the four flagship figures, drawn in the same outline as the characters.
interface Props {
  figure: 'car' | 'atomio' | 'agents' | 'greenhouse';
}

const { figure } = Astro.props;
const labels = {
  car: 'A small cartoon robot car with two round sensor eyes and a circuit board on its back',
  atomio: 'A browser window showing a building made of coloured blocks under a crane',
  agents: 'Three small robot heads passing a document along a line of arrows',
  greenhouse: 'A glass greenhouse with a seedling growing over a microchip',
};
const bd = `bd-${figure}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="figure" viewBox="0 0 320 220" role="img" aria-label={labels[figure]}>
  <defs><pattern id={bd} width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4.5" cy="4.5" r="2.6" fill="#17130f" /></pattern></defs>
  <g stroke="#17130f" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">
    {
      figure === 'car' && (
        <>
          <ellipse cx="168" cy="196" rx="118" ry="10" fill={`url(#${bd})`} stroke="none" />
          <rect x="98" y="36" width="116" height="48" rx="12" fill="#6fd08c" />
          <path d="M116 52h0m20 0h0m20 0h0m20 0h0m20 0h0" stroke-width="8" fill="none" />
          <rect x="46" y="72" width="228" height="92" rx="32" fill="#fffbf0" />
          <circle cx="118" cy="112" r="22" fill="#5cc8f5" />
          <circle cx="202" cy="112" r="22" fill="#5cc8f5" />
          <circle cx="118" cy="112" r="8" fill="#17130f" stroke="none" />
          <circle cx="202" cy="112" r="8" fill="#17130f" stroke="none" />
          <path d="M149 138q11 10 22 0" fill="none" />
          <circle cx="92" cy="168" r="27" fill="#17130f" />
          <circle cx="228" cy="168" r="27" fill="#17130f" />
          <circle cx="92" cy="168" r="9" fill="#ffd23f" stroke="none" />
          <circle cx="228" cy="168" r="9" fill="#ffd23f" stroke="none" />
        </>
      )
    }
    {
      figure === 'atomio' && (
        <>
          <rect x="48" y="38" width="240" height="160" rx="20" fill={`url(#${bd})`} stroke="none" />
          <rect x="38" y="28" width="240" height="160" rx="20" fill="#fffbf0" />
          <path d="M38 60h240" fill="none" />
          <circle cx="60" cy="44" r="4" fill="#17130f" stroke="none" />
          <circle cx="76" cy="44" r="4" fill="#17130f" stroke="none" />
          <circle cx="92" cy="44" r="4" fill="#17130f" stroke="none" />
          <rect x="78" y="116" width="48" height="54" fill="#ff6b9a" />
          <rect x="126" y="90" width="52" height="80" fill="#5cc8f5" />
          <rect x="178" y="132" width="44" height="38" fill="#6fd08c" />
          <path d="M142 108h20m-20 20h20m-20 20h20" stroke-width="4" fill="none" />
          <path d="M200 132V78h52m-52 0h-18m58 0v20" fill="none" />
          <rect x="231" y="98" width="18" height="14" rx="4" fill="#ffd23f" />
          <path d="M62 170h192" fill="none" />
        </>
      )
    }
    {
      figure === 'agents' && (
        <>
          <path d="M96 96h30m68 0h30" fill="none" />
          <path d="m118 88 8 8-8 8m98-16 8 8-8 8" fill="none" />
          <path d="M62 54V40m98 14V40m98 14V40" fill="none" />
          <circle cx="62" cy="36" r="6" fill="#ffd23f" />
          <circle cx="160" cy="36" r="6" fill="#ffd23f" />
          <circle cx="258" cy="36" r="6" fill="#ffd23f" />
          <rect x="30" y="62" width="64" height="64" rx="18" fill="#5cc8f5" />
          <rect x="128" y="62" width="64" height="64" rx="18" fill="#fffbf0" />
          <rect x="226" y="62" width="64" height="64" rx="18" fill="#ff6b9a" />
          {[62, 160, 258].map((x) => (
            <>
              <circle cx={x - 12} cy="90" r="5" fill="#17130f" stroke="none" />
              <circle cx={x + 12} cy="90" r="5" fill="#17130f" stroke="none" />
              <path d={`M${x - 7} 104q7 7 14 0`} fill="none" stroke-width="4" />
            </>
          ))}
          <rect x="124" y="150" width="84" height="54" rx="10" fill={`url(#${bd})`} stroke="none" />
          <rect x="118" y="144" width="84" height="54" rx="10" fill="#fffbf0" />
          <path d="M134 162h52m-52 16h34" stroke-width="5" fill="none" />
        </>
      )
    }
    {
      figure === 'greenhouse' && (
        <>
          <path d="M70 196V108l100-60 100 60v88z" fill={`url(#${bd})`} stroke="none" />
          <path d="M58 186V98l100-60 100 60v88z" fill="#d3f3dc" />
          <path d="M158 38v60M58 98h200M108 68v118M208 68v118" fill="none" stroke-width="4" />
          <path d="M158 170v-42" fill="none" />
          <path d="M158 142c-24-2-34-18-32-36 20 0 34 12 32 36z" fill="#6fd08c" />
          <path d="M158 132c22-4 30-18 28-34-18 0-30 12-28 34z" fill="#6fd08c" />
          <rect x="128" y="164" width="60" height="30" rx="9" fill="#17130f" />
          <circle cx="148" cy="178" r="3.5" fill="#fffbf0" stroke="none" />
          <circle cx="168" cy="178" r="3.5" fill="#fffbf0" stroke="none" />
          <path d="M36 186h244" fill="none" />
        </>
      )
    }
  </g>
</svg>

<style>
  .figure {
    width: 100%;
    height: auto;
  }
</style>
