---
import Arrow from './Arrow.astro';
import Charm from './Charm.astro';
import '@fontsource/mochiy-pop-one/400.css';
import { site, features, layers } from '../data/site';

// The name is set letter by letter so each one can sit on a bouncing baseline.
const tilt = [-4, 3, -2, 4, -3, 2, -5, 3, -2, 4];
const lift = [0, -5, 3, -2, 5, -4, 0, 6, -3, 2];
let n = 0;
const words = site.name.split(' ').map((word) =>
  [...word].map((ch) => {
    const i = n++;
    return { ch, r: tilt[i % tilt.length], y: lift[i % lift.length] };
  }),
);

// Callouts run down the right of the figure, top to bottom: ML, security, hardware.
const callouts = [...layers].reverse();

// Manga focus lines (shūchūsen): thin wedges converging on the stack, with a clear
// centre. Lengths vary on a fixed pattern so the burst reads hand-inked, not ruled.
const lineLen = [0.5, 0.62, 0.44, 0.7, 0.55, 0.4, 0.66, 0.48, 0.58, 0.42, 0.72, 0.52];
const focusLines = Array.from({ length: 64 }, (_, i) => {
  const a = (i / 64) * Math.PI * 2 + (i % 3) * 0.012;
  const inner = 0.34 + lineLen[i % lineLen.length] * 0.22;
  const half = 0.011 + (i % 4) * 0.003;
  const p = (r: number, da: number) =>
    `${(50 + Math.cos(a + da) * r * 100).toFixed(2)} ${(50 + Math.sin(a + da) * r * 100).toFixed(2)}`;
  return `M${p(0.8, -half)} L${p(inner, 0)} L${p(0.8, half)} Z`;
}).join(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="bop">
        <span class="sr-only">{site.name}</span>
        <span class="bop__row" aria-hidden="true">
          {
            words.map((letters) => (
              <>
                <span class="bop__word">
                  {letters.map((l) => (
                    <span class="bop__l" data-pop style={`--r:${l.r}deg;--y:${l.y}px`}>
                      {l.ch}
                    </span>
                  ))}
                </span>{' '}
              </>
            ))
          }
        </span>
      </h1>

      <p class="hero__line">
        One engineer, three layers: firmware, security and machine learning.
      </p>

      <div class="sticker features">
        <Charm kind="led" class="features__charm" />
        <h2 class="features__title">Features</h2>
        <ul class="features__list">
          {
            features.map((f) => (
              <li class={`tone-${f.tone}`}>
                <span class="dot" aria-hidden="true" />
                <span>{f.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__actions">
        <a class="btn btn--big" href={`mailto:${site.email}`}>
          Email Philip
          <span class="btn__dot"><Arrow /></span>
        </a>
        <a class="hero__link" href={site.github}>See the code on GitHub</a>
      </div>
    </div>

    <figure class="hero__fig">
      <div class="stack" data-stack>
        <div class="stack__art">
          <svg class="stack__poster" viewBox="0 0 300 360" aria-hidden="true">
            <g stroke="#17130f" stroke-width="6" stroke-linejoin="round" stroke-linecap="round">
              <ellipse cx="162" cy="338" rx="112" ry="14" fill="#17130f" opacity="0.25" stroke="none"></ellipse>
              <path d="M126 76 116 46m58 30 10-30" fill="none"></path>
              <circle cx="116" cy="40" r="9" fill="#ffd23f"></circle>
              <circle cx="184" cy="40" r="9" fill="#ffd23f"></circle>
              <rect x="22" y="262" width="26" height="12" rx="5" fill="#fffbf0"></rect>
              <rect x="22" y="288" width="26" height="12" rx="5" fill="#fffbf0"></rect>
              <rect x="252" y="262" width="26" height="12" rx="5" fill="#fffbf0"></rect>
              <rect x="252" y="288" width="26" height="12" rx="5" fill="#fffbf0"></rect>
              <rect x="44" y="236" width="212" height="96" rx="30" fill="#6fd08c"></rect>
              <rect x="66" y="150" width="168" height="90" rx="30" fill="#ff6b9a"></rect>
              <ellipse cx="150" cy="106" rx="70" ry="54" fill="#5cc8f5"></ellipse>
              <g fill="#17130f" stroke="none">
                <ellipse cx="130" cy="100" rx="6" ry="8"></ellipse>
                <ellipse cx="170" cy="100" rx="6" ry="8"></ellipse>
                <ellipse cx="150" cy="118" rx="5" ry="7"></ellipse>
                <ellipse cx="128" cy="186" rx="6" ry="8"></ellipse>
                <ellipse cx="172" cy="186" rx="6" ry="8"></ellipse>
                <circle cx="150" cy="204" r="6"></circle>
                <path d="M146 206h8l2 14h-12z"></path>
                <ellipse cx="126" cy="276" rx="6" ry="8"></ellipse>
                <ellipse cx="174" cy="276" rx="6" ry="8"></ellipse>
              </g>
              <path d="M141 292q9 9 18 0" fill="none"></path>
            </g>
          </svg>
        </div>

        <div class="manga" aria-hidden="true">
          <svg class="manga__lines" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
            <path d={focusLines} />
          </svg>
          <span class="manga__sfx" lang="ja">ドン！</span>
        </div>

        <svg class="stack__leaders" aria-hidden="true">
          {
            callouts.map((layer) => (
              <g data-leader={layer.id} class={`tone-${layer.id}`}>
                <line />
                <circle r="6" />
              </g>
            ))
          }
        </svg>

        <ul class="stack__callouts">
          {
            callouts.map((layer) => (
              <li class={`callout callout--${layer.id} tone-${layer.id}`}>
                <a href={`#${layer.id}`} data-callout={layer.id}>
                  <strong>{layer.id === 'ml' ? 'Machine learning' : layer.name}</strong>
                  <small>{layer.callout}</small>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <figcaption class="hero__caption">
        <span class="data">Fig. 1</span>
        Block diagram. Drag to turn it, or pick a layer. Scroll to take it apart.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 5.5rem);
    background-color: var(--yuzu);
    background-image: radial-gradient(circle, var(--yuzu-deep) 2.4px, transparent 2.9px);
    background-size: 26px 26px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 13fr) minmax(0, 11fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: clamp(1.1rem, 2vw, 1.6rem);
    justify-items: start;
  }

  /* The name: pop-art lettering, extruded in strawberry, outlined in ink. */
  .bop {
    font-size: var(--step-4);
    line-height: 1.14;
    letter-spacing: 0.035em;
    color: var(--stock);
    -webkit-text-stroke: 8px var(--ink);
    paint-order: stroke fill;
    text-shadow:
      1px 1px 0 var(--ichigo),
      2px 2px 0 var(--ichigo),
      3px 3px 0 var(--ichigo),
      4px 4px 0 var(--ichigo),
      5px 5px 0 var(--ichigo),
      6px 6px 0 var(--ichigo),
      7px 7px 0 var(--ink),
      8px 8px 0 var(--ink);
  }

  .bop__word {
    display: inline-block;
    white-space: nowrap;
  }

  .bop__l {
    display: inline-block;
    rotate: var(--r);
    translate: 0 var(--y);
    transform-origin: 50% 90%;
  }

  /* Each letter squashes like soft clay when the pointer passes over it. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bop__l:hover {
      animation: squish 520ms var(--ease-spring);
    }
  }

  @keyframes squish {
    0% {
      scale: 1 1;
    }
    25% {
      scale: 1.18 0.78;
    }
    55% {
      scale: 0.92 1.1;
    }
    100% {
      scale: 1 1;
    }
  }

  .hero__line {
    max-width: 38rem;
    font: 700 var(--step-2) / 1.2 var(--font-display);
  }

  .features {
    width: min(100%, 35rem);
    padding: 1.1rem 1.4rem 1.3rem;
  }

  .features :global(.features__charm) {
    top: -2.4rem;
    right: 1.5rem;
    rotate: 14deg;
  }

  .features__title {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }

  .features__list {
    display: grid;
    gap: 0.45rem;
  }

  .features__list li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .features__list .dot {
    translate: 0 0.08em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.4rem;
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .hero__fig {
    display: grid;
    gap: 0.75rem;
  }

  /* The figure: the stack on the left, its labels in a column on the right. */
  .stack {
    --label-col: 0.32;
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-height: min(72vh, 38rem);
    margin-inline: auto;
    touch-action: pan-y;
    cursor: grab;
  }

  .stack:active {
    cursor: grabbing;
  }

  .stack__art {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc((1 - var(--label-col)) * 100%);
  }

  .stack__poster {
    width: 100%;
    height: 100%;
    padding: 6% 4%;
  }

  /* The anime beat: focus lines burst behind the stack as it comes apart, with a
     katakana impact effect ("don!"). The scene drives --burst and --sfx from the scroll;
     without it they stay at zero and nothing shows. */
  .manga {
    position: absolute;
    /* Ends at the figure's bottom edge so the burst never crosses the Fig. 1 caption. */
    inset: -8% calc(var(--label-col) * 100% - 4%) 0 -8%;
    pointer-events: none;
    opacity: var(--burst, 0);
  }

  .manga__lines {
    width: 100%;
    height: 100%;
    rotate: calc(var(--burst, 0) * 4deg);
    scale: calc(0.9 + var(--burst, 0) * 0.1);
  }

  .manga__lines path {
    fill: var(--ink);
  }

  .manga__sfx {
    position: absolute;
    left: 2%;
    top: 4%;
    font: 400 clamp(2.4rem, 1.4rem + 3vw, 4.2rem) / 1 'Mochiy Pop One', var(--font-display);
    color: var(--ichigo);
    -webkit-text-stroke: 7px var(--ink);
    paint-order: stroke fill;
    text-shadow: 5px 5px 0 var(--ink);
    letter-spacing: -0.04em;
    opacity: var(--sfx, 0);
    rotate: -12deg;
    scale: calc(0.55 + var(--sfx, 0) * 0.45);
    transform-origin: 30% 70%;
  }

  .stack__leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  .stack:global(.has-leaders) .stack__leaders {
    opacity: 1;
  }

  .stack__leaders line {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 2 6;
  }

  .stack__leaders circle {
    fill: var(--tone);
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  /* Callouts are real links, set as comic caption boxes. Script positions them
     beside their characters; without it they sit at fixed heights. */
  .callout {
    position: absolute;
    left: calc((1 - var(--label-col)) * 100% + 0.25rem);
    right: 0;
    z-index: 1;
    transition:
      opacity 300ms var(--ease-out),
      translate 400ms var(--ease-out);
  }

  .stack:global(.is-away) .callout,
  .stack:global(.is-away) .stack__leaders {
    opacity: 0;
  }

  .stack:global(.is-away) .callout {
    translate: 1rem 0;
  }

  .callout--ml {
    top: 18%;
  }

  .callout--security {
    top: 44%;
  }

  .callout--hardware {
    top: 68%;
  }

  .callout a {
    display: grid;
    gap: 0.1rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.4rem 0.7rem 0.45rem;
    text-decoration: none;
    background: var(--stock);
    border: 2px solid var(--ink);
    border-radius: 3px;
    transition:
      background-color 160ms var(--ease-out),
      translate 260ms var(--ease-spring);
  }

  .callout strong {
    font: 700 1.02rem / 1.15 var(--font-display);
  }

  .callout small {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  @media (hover: hover) {
    .callout a:hover {
      background: var(--tone);
      translate: -2px -2px;
    }
  }

  .callout a:global(.is-hot) {
    background: var(--tone);
  }

  .callout a:active {
    translate: 1px 1px;
  }

  .hero__caption {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    text-align: center;
    font-size: var(--step--1);
    font-weight: 700;
  }

  .hero__caption .data {
    padding: 0.1em 0.55em;
    background: var(--ink);
    color: var(--stock);
    border-radius: 999px;
  }

  /* On narrow screens the figure moves up under the headline so the three
     characters lead the first screen. */
  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
    }

    .hero__copy {
      display: contents;
    }

    .bop {
      order: 1;
    }

    .hero__line {
      order: 2;
    }

    .hero__fig {
      order: 3;
    }

    .features {
      order: 4;
      width: 100%;
      margin-top: 1.5rem;
    }

    .hero__actions {
      order: 5;
    }

    .stack {
      --label-col: 0.36;
      aspect-ratio: auto;
      height: 300px;
      max-height: none;
    }
  }

  @media (max-width: 30rem) {
    .bop {
      -webkit-text-stroke-width: 6px;
      text-shadow:
        1px 1px 0 var(--ichigo),
        2px 2px 0 var(--ichigo),
        3px 3px 0 var(--ichigo),
        4px 4px 0 var(--ink),
        5px 5px 0 var(--ink);
    }

    .callout strong {
      font-size: 0.95rem;
    }

    .callout small {
      display: none;
    }
  }
</style>
