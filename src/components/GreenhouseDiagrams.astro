---
import { Image } from 'astro:assets';
import architecture from '../assets/projects/greenhouse/system-block-diagram.png';
import iotFlow from '../assets/projects/greenhouse/iot-network-flow.png';
import diseaseFlow from '../assets/projects/greenhouse/disease-identification-flow.png';

interface Props {
  headingLevel?: 'h3' | 'h4';
}

const Heading = Astro.props.headingLevel ?? 'h4';

const flows = [
  {
    id: 'greenhouse-iot-flow',
    title: 'IoT and sensor network',
    image: iotFlow,
    description: 'The monitoring loop collects and cleans sensor readings, takes control actions, and keeps a local display. Data uploads when the communication gateway is available.',
    alt: 'Original IoT flowchart: boot, scheduled collection of sensor data and images, cleaning, local storage and display, control actions and alerts, and upload through the communication gateway.',
  },
  {
    id: 'greenhouse-disease-flow',
    title: 'Disease identification',
    image: diseaseFlow,
    description: 'An image arrives over HTTP. SAM generates masks; colour, size and circularity filters select leaf crops for the classifier. The response returns predictions and an image overlay.',
    alt: 'Original disease-identification flowchart: receive and preprocess an image, generate SAM masks, filter by colour, size and circularity, crop leaves, predict diseases, and return either no disease or an overlay with disease information.',
  },
];
---

<div class="diagrams">
  <div class="architecture">
    <Heading class="diagram-title">System block diagram</Heading>
    <p class="architecture__intro">
      The report’s block diagram connects sensing, processing, actuators, the IoT network and the user interface.
      Open any diagram at full size to inspect the flow.
    </p>
    <a class="drawing" href={architecture.src} aria-label="View full-size greenhouse system block diagram">
      <Image src={architecture} format="webp" quality={90} widths={[640, 1200, 1800]}
        sizes="(max-width: 1280px) calc(100vw - 32px), 1248px" loading="lazy" decoding="async"
        alt="Original system block diagram showing power distribution, sensors and camera, a processing unit, actuators, a knowledge database, IoT communication, machine learning models and a multimodal user interface." />
    </a>
  </div>

  <div class="flows">
    {flows.map((flow) => (
      <div class="flow">
        <Heading id={flow.id} class="diagram-title">{flow.title}</Heading>
        <p id={`${flow.id}-description`}>{flow.description}</p>
        <a class="drawing" href={flow.image.src} aria-label={`View full-size ${flow.title.toLowerCase()} flowchart`}
          aria-describedby={`${flow.id}-description`}>
          <Image src={flow.image} alt={flow.alt} format="webp" quality={90}
            widths={[480, 900, 1800]} sizes="(max-width: 896px) calc(100vw - 32px), 608px"
            loading="lazy" decoding="async" />
        </a>
      </div>
    ))}
  </div>
</div>

<style>
  .diagrams {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .diagram-title {
    margin: 0;
    font: 700 var(--step-2) / 1.3 var(--font-display);
    color: var(--diagram-heading, var(--stock));
    text-wrap: balance;
  }

  p {
    max-width: 62ch;
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .architecture {
    display: grid;
    gap: 1rem;
  }

  .architecture__intro {
    margin-bottom: 0.5rem;
  }

  .flows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .flow {
    display: grid;
    grid-template-rows: auto minmax(7rem, auto) auto;
    gap: 1rem;
  }

  .drawing {
    display: block;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    background: #fff;
    border-radius: var(--r-md);
  }

  .drawing :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 56rem) {
    .flows {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .flow {
      grid-template-rows: auto;
    }
  }
</style>
