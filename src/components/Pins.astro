---
import BopText from './BopText.astro';
import { pins } from '../data/site';

// Numbered the way a real dual in-line package is: down the left, back up the right.
const count = pins.left.length;
const left = pins.left.map((label, i) => ({ label, n: i + 1 }));
const right = pins.right.map((label, i) => ({ label, n: count * 2 - i }));
---

<section class="pins" aria-labelledby="pins-title">
  <div class="seam" aria-hidden="true" style="--prev: #dff4fd"></div>
  <div class="wrap">
    <h2 id="pins-title" class="h-section"><BopText text="Pin configuration" /></h2>
    <p class="lede">The languages and platforms behind the work on this page.</p>

    <figure class="chipfig">
      <div class="chipfig__side chipfig__side--left">
        <h3 class="chipfig__label">Close to the metal</h3>
        <ul>
          {
            left.map((pin) => (
              <li class="pin">
                <span class="pin__name">{pin.label}</span>
                <span class="pin__lead" aria-hidden="true" />
                <span class="data pin__n" aria-hidden="true">{pin.n}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="chipfig__body" aria-hidden="true">
        <span class="chipfig__notch"></span>
        <svg viewBox="0 0 120 80" class="chipfig__face">
          <g fill="#17130f">
            <ellipse cx="38" cy="30" rx="7" ry="9"></ellipse>
            <ellipse cx="82" cy="30" rx="7" ry="9"></ellipse>
          </g>
          <circle cx="41" cy="26" r="2.6" fill="#fffbf0"></circle>
          <circle cx="85" cy="26" r="2.6" fill="#fffbf0"></circle>
          <ellipse cx="20" cy="48" rx="10" ry="5.5" fill="#ff8fb0"></ellipse>
          <ellipse cx="100" cy="48" rx="10" ry="5.5" fill="#ff8fb0"></ellipse>
          <path d="M50 46q10 11 20 0" fill="none" stroke="#17130f" stroke-width="5" stroke-linecap="round"></path>
        </svg>
        <span class="data chipfig__part">PSO-3L</span>
      </div>

      <div class="chipfig__side chipfig__side--right">
        <h3 class="chipfig__label">Up the stack</h3>
        <ul>
          {
            right.map((pin) => (
              <li class="pin">
                <span class="data pin__n" aria-hidden="true">{pin.n}</span>
                <span class="pin__lead" aria-hidden="true" />
                <span class="pin__name">{pin.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <figcaption class="chipfig__caption">
        <span class="data">Fig. 2</span>
        Sixteen pins, all in use.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .pins {
    padding-block: var(--band-pad);
    background-color: var(--stock);
    background-image:
      linear-gradient(var(--yuzu-soft) 2px, transparent 2px),
      linear-gradient(90deg, var(--yuzu-soft) 2px, transparent 2px);
    background-size: 32px 32px;
  }

  .pins .lede {
    margin-top: 1rem;
  }

  .chipfig {
    --row: 3.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(9rem, 20vw, 15rem) minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: end;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .chipfig__label {
    margin-bottom: 0.9rem;
    font-size: var(--step-1);
  }

  .chipfig__side--left {
    text-align: right;
  }

  .pin {
    display: flex;
    align-items: center;
    height: var(--row);
  }

  .chipfig__side--left .pin {
    justify-content: flex-end;
  }

  .pin__name {
    padding: 0.3em 0.95em;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    background: var(--stock);
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    transition:
      translate 240ms var(--ease-spring),
      background-color 160ms var(--ease-out);
  }

  /* Hovering a pin lights its lead, like probing it on the bench. */
  .pin__lead {
    transition: background-color 160ms var(--ease-out);
  }

  @media (hover: hover) {
    .pin:hover .pin__lead {
      background: var(--ichigo-deep);
    }

    .chipfig__side--left .pin:hover .pin__name {
      translate: -4px 0;
    }

    .chipfig__side--right .pin:hover .pin__name {
      translate: 4px 0;
    }
  }

  .chipfig__side--left .pin:nth-child(odd) .pin__name {
    background: var(--matcha);
  }

  .chipfig__side--right .pin:nth-child(odd) .pin__name {
    background: var(--ramune);
  }

  .chipfig__side--left .pin:nth-child(4n) .pin__name,
  .chipfig__side--right .pin:nth-child(4n) .pin__name {
    background: var(--ichigo);
  }

  .pin__lead {
    flex: 0 1 4rem;
    min-width: 1.25rem;
    height: var(--line);
    background: var(--ink);
  }

  .pin__n {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    font-weight: 700;
    color: var(--stock);
    background: var(--ink);
    border-radius: 50%;
  }

  .chipfig__side--left .pin__n {
    margin-right: -0.95rem;
  }

  .chipfig__side--right .pin__n {
    margin-left: -0.95rem;
  }

  .pin__n {
    position: relative;
    z-index: 1;
  }

  .chipfig__body {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    height: calc(var(--row) * 8 + 1.5rem);
    margin-bottom: -0.75rem;
    background: var(--yuzu);
    border: var(--line) solid var(--ink);
    border-radius: var(--r-lg);
  }

  .chipfig__body::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--line));
    translate: 10px 10px;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(circle, var(--ink) 1.6px, transparent 2.1px) 0 0 / 7px 7px;
  }

  .chipfig__notch {
    position: absolute;
    top: -3px;
    left: 50%;
    width: 3rem;
    height: 1.5rem;
    translate: -50% 0;
    background: var(--stock);
    border: var(--line) solid var(--ink);
    border-top: 0;
    border-radius: 0 0 3rem 3rem;
  }

  .chipfig__face {
    width: min(70%, 7.5rem);
  }

  .chipfig__part {
    padding: 0.15em 0.7em;
    font-size: 1rem;
    font-weight: 700;
    color: var(--stock);
    background: var(--ink);
    border-radius: 999px;
  }

  .chipfig__caption {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 2.25rem;
    font-size: var(--step--1);
    font-weight: 700;
  }

  .chipfig__caption .data {
    padding: 0.1em 0.55em;
    color: var(--stock);
    background: var(--ink);
    border-radius: 999px;
  }

  /* On narrow screens the pinout stays a figure: a slim chip with its pins either side,
     the labels set smaller so all sixteen still fit. */
  @media (max-width: 52rem) {
    .chipfig {
      --row: 2.6rem;
      grid-template-columns: minmax(0, 1fr) 3.6rem minmax(0, 1fr);
    }

    .chipfig__label {
      font-size: var(--step-0);
    }

    .chipfig__side--right .chipfig__label {
      text-align: right;
    }

    .pin__name {
      padding: 0.2em 0.55em;
      font-size: 0.78rem;
      white-space: normal;
      line-height: 1.15;
      text-align: center;
    }

    .pin__lead {
      flex-basis: 0.6rem;
      min-width: 0.4rem;
    }

    .pin__n {
      width: 1.3rem;
      height: 1.3rem;
      font-size: 0.68rem;
    }

    .chipfig__side--left .pin__n {
      margin-right: -0.65rem;
    }

    .chipfig__side--right .pin__n {
      margin-left: -0.65rem;
    }

    .chipfig__body {
      gap: 0.5rem;
      border-radius: var(--r-md);
    }

    .chipfig__face {
      width: 2.6rem;
    }

    .chipfig__part {
      writing-mode: vertical-rl;
      padding: 0.6em 0.15em;
      font-size: 0.72rem;
    }

    .chipfig__notch {
      width: 1.6rem;
      height: 0.9rem;
    }
  }
</style>
