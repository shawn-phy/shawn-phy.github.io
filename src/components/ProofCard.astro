---
// One card of real project proof, built on the same plate as the drawings: a stage
// over a legend bar, inside a sticker. Three kinds:
//   site     a capture of a live website, cropped to the top of the page
//   photos   build photographs, set as comic panels with ink gutters
//   diagram  a diagram from the project report, on paper
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';

export interface Proof {
  key: string;
  label: string;
  kind: 'site' | 'photos' | 'diagram';
  title?: string;
  url?: string;
  image?: ImageMetadata;
  alt?: string;
  photos?: { image: ImageMetadata; alt: string }[];
  more?: { href: string; text: string };
}

interface Props {
  proof: Proof;
  depth: number;
  /** Position in the deck after the drawing (1, 2...), used to fan the tabs out. */
  order: number;
}

const { proof: p, depth, order } = Astro.props;
const domain = p.url ? new URL(p.url).hostname.replace(/^www\./, '') : '';
const back = depth > 0;
---

<figure
  class:list={['sticker', 'deck__card', 'proof', `proof--${p.kind}`]}
  data-card={p.key}
  data-depth={depth}
  style={`--depth:${depth}`}
  aria-hidden={back ? 'true' : undefined}
>
  <span class="deck__tab" aria-hidden="true" style={`--tab-right:calc(1.2rem + ${order} * 7.6rem)`}>{p.label}</span>
  <div class="plate-stage proof__stage">
    <div class="deck__media">
      {
        p.kind === 'site' && p.image && (
          <Image
            class="proof__shot"
            src={p.image}
            alt={p.alt ?? ''}
            format="webp"
            quality={85}
            widths={[480, 800, 1200]}
            sizes="(max-width: 960px) calc(100vw - 4rem), 760px"
            loading="lazy"
            decoding="async"
          />
        )
      }
      {
        p.kind === 'photos' && p.photos && (
          <div class="proof__panels">
            {p.photos.map((ph, i) => (
              <Image
                class={`proof__panel proof__panel--${i}`}
                src={ph.image}
                alt={ph.alt}
                format="webp"
                quality={80}
                widths={i === 0 ? [480, 800] : [320, 560]}
                sizes={i === 0 ? '(max-width: 960px) 50vw, 380px' : '(max-width: 960px) 25vw, 190px'}
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        )
      }
      {
        p.kind === 'diagram' && p.image && (
          <Image
            class="proof__diagram"
            src={p.image}
            alt={p.alt ?? ''}
            format="webp"
            quality={90}
            widths={[640, 1200]}
            sizes="(max-width: 960px) calc(100vw - 4rem), 760px"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </div>
  <figcaption class="plate-legend proof__legend">
    <span class="data plate-pill">{p.label}</span>
    {p.title && <span class="proof__title">{p.title}</span>}
    {domain && <span class="data proof__domain">{domain}</span>}
    {
      p.url && (
        <a class="proof__link" href={p.url} target="_blank" rel="noopener noreferrer" tabindex={back ? -1 : undefined}>
          Visit site
          <Arrow />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      )
    }
    {
      p.more && (
        <a class="proof__link" href={p.more.href} tabindex={back ? -1 : undefined}>
          {p.more.text}
          <Arrow />
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  .proof {
    --shade: var(--yuzu);
    color: var(--ink);
  }

  .proof__stage {
    background: var(--stock);
  }

  .deck__media {
    position: absolute;
    inset: 0;
  }

  /* A site capture shows the top of the page, as a visitor first sees it. */
  .proof__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Build photographs as comic panels: ink gutters, one lead panel. */
  .proof__panels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 4px;
    height: 100%;
    background: var(--ink);
  }

  .proof__panel {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proof__panel--0 {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  .proof__panel--3 {
    grid-column: 3 / 5;
  }

  /* A report diagram sits on paper with a margin, never cropped. */
  .proof__diagram {
    width: 100%;
    height: 100%;
    padding: 4%;
    object-fit: contain;
  }

  .proof__title {
    font: 700 var(--step-0) / 1.2 var(--font-display);
  }

  .proof__domain {
    font-weight: 700;
  }

  .proof__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    margin-left: auto;
    font-weight: 700;
  }

  .proof__link :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
</style>
