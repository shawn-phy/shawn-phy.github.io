---
// Flagship work, each set out as a datasheet application note. A project with real
// proof (live sites, build photographs, report diagrams) shows it on a deck under its
// drawing: the drawing leads, and the proof arrives on top as the note scrolls into
// view (see src/scripts/proof-deck.ts).
import BopText from './BopText.astro';
import FigurePlate from './FigurePlate.astro';
import ProofCard, { type Proof } from './ProofCard.astro';
import { flagships, layerNames } from '../data/site';
import laxmi from '../assets/projects/atomio/laxmi-group-website.png';
import safeharbor from '../assets/projects/atomio/safeharbor-website.png';
import seniorpark from '../assets/projects/seniorpark/seniorpark-website.png';
import interior from '../assets/projects/greenhouse/greenhouse-interior.jpg';
import display from '../assets/projects/greenhouse/electronics-display.jpg';
import pipework from '../assets/projects/greenhouse/growing-bed-pipework.jpg';
import tomatoes from '../assets/projects/greenhouse/tomatoes-on-vine.jpg';
import blockDiagram from '../assets/projects/greenhouse/system-block-diagram.png';

// Proof per project. Sources and limits are recorded in design/website-evidence.md
// and design/greenhouse/claims.md.
const proofs: Record<string, Proof[]> = {
  agents: [
    {
      key: 'seniorpark',
      label: 'Live site',
      kind: 'site',
      title: 'Seniorpark public website',
      url: 'https://seniorpark.io',
      image: seniorpark,
      alt: 'Seniorpark public homepage with its senior care facility search.',
    },
  ],
  atomio: [
    {
      key: 'laxmi',
      label: 'Laxmi Group',
      kind: 'site',
      title: 'Client site',
      url: 'https://www.laxmigroup.co.ke/',
      image: laxmi,
      alt: 'Laxmi Group website About page, with team, construction and community project photographs.',
    },
    {
      key: 'safeharbor',
      label: 'SafeHarbor',
      kind: 'site',
      title: 'Client site',
      url: 'https://safeharbor.co.ke/',
      image: safeharbor,
      alt: 'SafeHarbor Consulting website homepage, with its health, safety and risk management services.',
    },
  ],
  greenhouse: [
    {
      key: 'photos',
      label: 'Build photos',
      kind: 'photos',
      photos: [
        { image: interior, alt: 'Tomato plants inside the timber-framed greenhouse, with translucent walls and overhead wiring.' },
        { image: display, alt: 'A wired electronics assembly with a display labelled temperature and humidity.' },
        { image: pipework, alt: 'Young plants in a soil bed beside black pipework and fittings along the greenhouse wall.' },
        { image: tomatoes, alt: 'A hand holding a cluster of green tomatoes still attached to the plant.' },
      ],
    },
    {
      key: 'diagram',
      label: 'Block diagram',
      kind: 'diagram',
      title: 'From the project report',
      image: blockDiagram,
      alt: 'System block diagram showing power distribution, sensors and camera, a processing unit, actuators, a knowledge database, IoT communication, machine learning models and a multimodal user interface.',
      more: { href: '/projects/smart-greenhouse/', text: 'All diagrams' },
    },
  ],
};

// After the hero, a 3D character drops onto a project it built: the chip onto the
// car, the ML character onto the agents and the greenhouse. On a deck it stands on
// whichever card is on top, so it stays put while the cards change under it.
const perches: Record<string, string> = { agents: 'ml', car: 'hardware', greenhouse: 'ml' };
---

<section id="applications" class="apps on-ink" aria-labelledby="apps-title">
  <div class="seam" aria-hidden="true" style="--prev: var(--yuzu)"></div>
  <div class="wrap">
    <h2 id="apps-title" class="h-section"><BopText text="Selected projects" /></h2>
    <p class="lede apps__lede">Multi-agent extraction, autonomous robotics, construction software and greenhouse monitoring.</p>

    <div class="notes">
      {
        flagships.map((f, i) => {
          const deck = proofs[f.figure] ?? [];
          return (
            <article id={f.id} class={`note note--${i} tone-${f.tone}`} aria-labelledby={`note-${f.id}`}>
              <div class="note__head">
                <h3 id={`note-${f.id}`} class="note__title">
                  {f.title}
                </h3>
                <p class="note__summary">{f.summary}</p>
                {f.contribution && <p class="note__contribution">{f.contribution}</p>}
                {f.writeupUrl && (
                  <a class="note__read" href={f.writeupUrl}>
                    Read the project summary<span class="sr-only">: {f.title}</span>
                  </a>
                )}
              </div>

              {deck.length > 0 ? (
                <div class="plate deck" data-deck data-front={deck[0].key}>
                  <div class="deck__switch" role="group" aria-label={`${f.title}: what to show`}>
                    <button type="button" class="deck__btn" data-show="drawing" aria-pressed="false">
                      Drawing
                    </button>
                    {deck.map((p, k) => (
                      <button type="button" class="deck__btn" data-show={p.key} aria-pressed={k === 0 ? 'true' : 'false'}>
                        {p.label}
                      </button>
                    ))}
                  </div>
                  <div class="deck__cards">
                    {perches[f.figure] && (
                      <span class="deck__floor" aria-hidden="true">
                        <span class="perch" data-perch-for={perches[f.figure]} />
                      </span>
                    )}
                    <FigurePlate
                      class="deck__card"
                      flagship={f}
                      figNo={i + 2}
                      data-card="drawing"
                      data-depth="1"
                      style="--depth:1"
                      aria-hidden="true"
                    >
                      <span slot="tab" class="deck__tab" aria-hidden="true">
                        Drawing
                      </span>
                    </FigurePlate>
                    {deck.map((p, k) => (
                      <ProofCard proof={p} depth={k === 0 ? 0 : k + 1} order={k + 1} />
                    ))}
                  </div>
                </div>
              ) : (
                <FigurePlate class="plate" flagship={f} figNo={i + 2} perch={perches[f.figure]} />
              )}

              <div class="sticker note__spec">
                <table class="table">
                  <caption class="sr-only">{f.title}: characteristics</caption>
                  <thead>
                    <tr>
                      <th scope="col">Parameter</th>
                      <th scope="col">Value</th>
                    </tr>
                  </thead>
                  <tbody>
                    {f.specs.map((s) => (
                      <tr>
                        <th scope="row">{s.label}</th>
                        <td>
                          {s.layers
                            ? s.layers.map((id) => (
                                <span class={`spec__layer tone-${id}`}>
                                  <span class="dot" aria-hidden="true" />
                                  {layerNames[id]}
                                </span>
                              ))
                            : s.value}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .apps {
    padding-block: var(--band-pad);
    color: var(--stock);
    background-color: var(--ink);
    background-image: radial-gradient(#3a3128 2.5px, transparent 3px);
    background-size: 30px 30px;
  }

  .apps__lede {
    margin-top: 1rem;
  }

  .notes {
    display: grid;
    gap: clamp(4.5rem, 10vw, 8rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .note {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }

  .note > * {
    min-width: 0;
  }

  /* Multi-agent extraction: the deck leads on the left, its numbers beside it. */
  .note--0 .note__head {
    grid-column: 1 / 9;
    grid-row: 1;
  }

  .note--0 .plate {
    grid-column: 1 / 9;
    grid-row: 2;
  }

  .note--0 .note__spec {
    grid-column: 9 / 13;
    grid-row: 2;
    align-self: center;
  }

  /* The car: a small object, so the title runs large and the drawing and its
     numbers sit side by side beneath it. */
  .note--1 .note__head {
    grid-column: 1 / 13;
    grid-row: 1;
  }

  .note--1 .note__title {
    font-size: var(--step-4);
  }

  .note--1 .plate {
    grid-column: 1 / 7;
    grid-row: 2;
  }

  .note--1 .note__spec {
    grid-column: 7 / 12;
    grid-row: 2;
    align-self: center;
  }

  /* Atomio: the company's two client sites on a deck at the right, its story and
     numbers stacked at the left. */
  .note--2 .note__head {
    grid-column: 1 / 5;
    grid-row: 1;
  }

  .note--2 .plate {
    grid-column: 5 / 13;
    grid-row: 1 / 3;
  }

  .note--2 .note__spec {
    grid-column: 1 / 5;
    grid-row: 2;
  }

  /* The greenhouse: hardware and ML in one build, on a single centred axis. */
  .note--3 {
    text-align: center;
  }

  .note--3 .note__head {
    grid-column: 3 / 11;
    grid-row: 1;
    justify-items: center;
  }

  .note--3 .note__summary {
    margin-inline: auto;
  }

  .note--3 .plate {
    grid-column: 3 / 11;
    grid-row: 2;
    text-align: left;
  }

  .note--3 .note__spec {
    grid-column: 4 / 10;
    grid-row: 3;
    margin-top: 0.75rem;
    text-align: left;
  }

  /* The top card's stage, traced in the deck's grid cell: the top card always sits
     there untransformed, so a character standing here is on whichever card is on top.
     The margin is the sticker's border, which insets the stage. */
  .deck__floor {
    position: relative;
    grid-area: 1 / 1;
    align-self: start;
    aspect-ratio: 320 / 220;
    margin: var(--line) var(--line) 0;
    pointer-events: none;
  }

  /* The same footprint as a perch on a single plate (FigurePlate.astro). */
  .perch {
    position: absolute;
    left: 2%;
    bottom: 0;
    width: 25%;
    height: 38%;
  }

  .note__head {
    display: grid;
    gap: 0.9rem;
  }

  .note__title {
    font-size: var(--step-3);
    color: var(--stock);
  }

  .note__summary {
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .note__contribution {
    max-width: 48ch;
    margin-inline: auto;
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.6;
    color: var(--yuzu);
  }

  .note__read {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  /* Characteristic tables. */
  .note__spec {
    --shade: var(--yuzu);
    color: var(--ink);
  }

  .note__spec tbody th,
  .note__spec td {
    padding-block: 0.6rem;
  }

  .note__spec tbody th {
    width: 36%;
    font-weight: 900;
  }

  .note__spec td {
    font-weight: 500;
  }

  .spec__layer {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-right: 1rem;
    font-weight: 700;
  }

  .spec__layer .dot {
    translate: 0 0.05em;
  }

  /* Narrow screens: heading, project visuals, then specifications. */
  @media (max-width: 60rem) {
    .note,
    .note--3 {
      grid-template-columns: minmax(0, 1fr);
      text-align: left;
    }

    .note .plate,
    .note .note__head,
    .note .note__spec {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 0;
    }

    .note .note__head {
      order: 1;
      justify-items: start;
    }

    .note .plate {
      order: 2;
    }

    .note .note__spec {
      order: 3;
    }

    .note__contribution {
      margin-inline: 0;
    }

    .note--1 .note__title {
      font-size: var(--step-3);
    }

    .note--3 .note__summary {
      margin-inline: 0;
    }
  }

  @media (max-width: 36rem) {
    .note__spec tbody th {
      width: 40%;
    }
  }
</style>
