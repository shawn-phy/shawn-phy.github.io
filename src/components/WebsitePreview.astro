---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';

interface Props {
  title: string;
  url: string;
  image: ImageMetadata;
  alt: string;
  sizes: string;
}

const { title, url, image, alt, sizes } = Astro.props;
const domain = new URL(url).hostname.replace(/^www\./, '');
---

<a class="website" href={url} target="_blank" rel="noopener noreferrer">
  <span class="website__heading">
    <span class="website__identity">
      <strong>{title}</strong>
      <span class="website__domain">{domain}</span>
    </span>
    <span class="website__visit">Visit site <span class="website__arrow"><Arrow /></span></span>
    <span class="sr-only">(opens in a new tab)</span>
  </span>
  <span class="website__image">
    <Image src={image} alt={alt} format="webp" quality={85}
      widths={[480, 768, 1080, 1440]} sizes={sizes} loading="lazy" decoding="async" />
  </span>
</a>

<style>
  .website {
    display: block;
    min-width: 0;
    color: var(--ink);
    background: var(--stock);
    border: var(--line) solid var(--stock);
    border-radius: var(--r-lg);
    text-decoration: none;
    transition: translate 180ms ease, border-color 180ms ease;
  }

  .website__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(0.75rem, 2vw, 1.25rem);
  }

  .website__identity {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
  }

  strong {
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .website__domain {
    font: 600 0.8rem / 1.5 var(--font-data);
    overflow-wrap: anywhere;
  }

  .website__visit {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .website__arrow {
    display: inline-flex;
    width: 0.9rem;
    height: 0.9rem;
    rotate: -45deg;
  }

  .website__image {
    display: block;
    overflow: hidden;
    border-radius: 0 0 calc(var(--r-lg) - var(--line)) calc(var(--r-lg) - var(--line));
  }

  .website__image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 220ms ease;
  }

  .website:is(:hover, :focus-visible) {
    border-color: var(--yuzu);
  }

  .website:focus-visible {
    outline: 3px solid var(--yuzu);
    outline-offset: 5px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .website:hover { translate: 0 -2px; }
    .website:hover .website__image :global(img) { transform: scale(1.02); }
  }

  @media (prefers-reduced-motion: reduce) {
    .website, .website__image :global(img) { transition: none; }
  }
</style>
